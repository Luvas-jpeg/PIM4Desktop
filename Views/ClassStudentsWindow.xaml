<Window x:Class="PIM4AdminDesktop.Views.ClassStudentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alunos da turma" Width="1000" Height="620" MinWidth="800" MinHeight="440"
        WindowStartupLocation="CenterOwner" Language="pt-BR" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding SelectedCourse.Nome}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedClass.LocalStartDate, StringFormat=Turma de {0:dd/MM/yyyy HH:mm}}" Margin="0,6,0,14" />
            <StackPanel x:Name="ActionsBar" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Atualizar alunos" Click="Refresh_OnClick" Padding="8,4" Margin="0,0,8,0" />
                <Button Content="Alterar matrícula" Click="Status_OnClick" IsEnabled="{Binding HasEnrollment}" Padding="8,4" Margin="0,0,8,0" />
                <Button Content="Transferir de turma" Click="Transfer_OnClick" IsEnabled="{Binding HasEnrollment}" Padding="8,4" />
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#A02E2A" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SuccessMessage}" Foreground="#156B5D" TextWrapping="Wrap" />
            <TextBlock Text="Selecione uma matrícula para alterar sua situação ou transferir a vaga. Uma lista vazia pode indicar que ainda não há matrículas nesta turma." TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <Grid>
            <DataGrid ItemsSource="{Binding ClassStudents}" SelectedItem="{Binding SelectedEnrollment}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Matrícula" Binding="{Binding EnrollmentId}" Width="80" />
                    <DataGridTextColumn Header="Aluno" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" />
                    <DataGridTextColumn Header="Situação" Binding="{Binding StatusLabel}" Width="110" />
                    <DataGridTextColumn Header="Participação" Binding="{Binding ParticipationLabel}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Background="#BBFFFFFF" Visibility="Collapsed" x:Name="BusyOverlay">
                <TextBlock Text="Consultando a API…" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
