<Window x:Class="PIM4AdminDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediShop Administracao"
        Width="1280" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#156B5D" />
        <SolidColorBrush x:Key="TextBrush" Color="#18201E" />
        <SolidColorBrush x:Key="MutedBrush" Color="#66736F" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="BorderBrush" Value="#C8D0CD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="BorderBrush" Value="#C8D0CD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
            <Setter Property="BorderBrush" Value="#DCE2E0" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAF9" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="LoginView" Background="#EEF2F0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Width="430" Padding="36" Background="White" BorderBrush="#D6DEDB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="MediShop" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="Administracao" Margin="0,8,0,6" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Acesso restrito aos administradores do instituto." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,28" />

                    <TextBlock Text="E-mail" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBox x:Name="EmailTextBox" Margin="0,0,0,18" />
                    <TextBlock Text="Senha" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <PasswordBox x:Name="PasswordInput" Margin="0,0,0,20" KeyDown="PasswordInput_OnKeyDown" />

                    <Border Padding="10" Margin="0,0,0,16" Background="#FFF1F0"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#A02E2A" TextWrapping="Wrap" />
                    </Border>

                    <Button Content="Entrar no painel" Height="44" Click="LoginButton_OnClick" />
                    <TextBlock Text="{Binding ApiAddress, StringFormat=API: {0}}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="AdminView">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#123B35" Padding="24,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MediShop" Foreground="White" FontSize="20" FontWeight="Bold" />
                        <Border Width="1" Height="22" Background="#52746F" Margin="18,0" />
                        <TextBlock Text="Painel administrativo" Foreground="#D8E5E2" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AdministratorName}" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Content="Atualizar" Background="#2B5B53" Margin="0,0,8,0" Click="RefreshButton_OnClick" />
                        <Button Content="Sair" Background="#8C3A36" Click="LogoutButton_OnClick" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,18">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Visão operacional" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{Binding LastUpdated, StringFormat=Atualizado em {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" MaxWidth="560">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#A02E2A" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#156B5D" TextWrapping="Wrap" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300"
                                 HorizontalAlignment="Right" Margin="0,6,0,0" ToolTip="Buscar por nome, curso, e-mail ou pedido"
                                 AutomationProperties.Name="Buscar nas listas" />
                        <TextBlock Text="Buscar por nome, curso, e-mail ou pedido" Foreground="#66736F" FontSize="11" HorizontalAlignment="Right" />
                    </StackPanel>
                </DockPanel>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
                    <Border Background="White" BorderBrush="#DCE2E0" BorderThickness="1" Padding="18" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="Cursos ativos" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding ActiveCourses}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="#DCE2E0" BorderThickness="1" Padding="18" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="Pedidos pendentes" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding PendingOrders}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="#DCE2E0" BorderThickness="1" Padding="18" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="Alunos ativos" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding ActiveStudents}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="#DCE2E0" BorderThickness="1" Padding="18">
                        <StackPanel><TextBlock Text="Receita confirmada" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding PaidRevenue, StringFormat=C}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
                    </Border>
                </UniformGrid>

                <TabControl Grid.Row="2" Background="White" BorderBrush="#DCE2E0">
                    <TabItem Header="Cursos">
                        <DockPanel Margin="12">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Novo curso" Click="NewCourse_OnClick" />
                                <Button Content="Editar curso" Click="EditCourse_OnClick" IsEnabled="{Binding HasCourse}" />
                                <Button Content="Arquivar / restaurar" Click="ArchiveCourse_OnClick" IsEnabled="{Binding HasCourse}" />
                            </StackPanel>
                        <DataGrid ItemsSource="{Binding CoursesView}" SelectedItem="{Binding SelectedCourse}" SelectionMode="Single" SelectionChanged="CourseSelection_OnChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                                <DataGridTextColumn Header="Curso" Binding="{Binding Nome}" Width="2*" />
                                <DataGridTextColumn Header="Modalidade" Binding="{Binding DeliveryMode}" Width="110" />
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="*" />
                                <DataGridTextColumn Header="Carga" Binding="{Binding WorkloadHours, StringFormat={}{0}h}" Width="80" />
                                <DataGridTextColumn Header="Preco" Binding="{Binding Preco, StringFormat=C}" Width="110" />
                                <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding IsActive}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Turmas">
                        <DockPanel Margin="12">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Selecione o curso para administrar suas turmas" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}"
                                          SelectionChanged="CourseSelection_OnChanged" DisplayMemberPath="Nome" MinHeight="36" Padding="8" AutomationProperties.Name="Curso das turmas" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Nova turma" Click="NewClass_OnClick" IsEnabled="{Binding HasCourse}" />
                                    <Button Content="Editar turma" Click="EditClass_OnClick" IsEnabled="{Binding HasClass}" />
                                    <Button Content="Alunos da turma" Click="ClassStudents_OnClick" IsEnabled="{Binding HasClass}" />
                                </StackPanel>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Turma" Binding="{Binding Id}" Width="70" />
                                    <DataGridTextColumn Header="Início (local)" Binding="{Binding LocalStartDate, StringFormat=dd/MM/yyyy HH:mm}" Width="160" />
                                    <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="*" />
                                    <DataGridTextColumn Header="Instrutor" Binding="{Binding Instructor}" Width="*" />
                                    <DataGridTextColumn Header="Capacidade" Binding="{Binding Capacity}" Width="100" />
                                    <DataGridTextColumn Header="Vagas" Binding="{Binding AvailableSeats}" Width="70" />
                                    <DataGridTextColumn Header="Situação" Binding="{Binding StatusLabel}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Pedidos">
                        <DockPanel Margin="12">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Detalhes / alterar situação" Click="EditOrder_OnClick" IsEnabled="{Binding HasOrder}" />
                            </StackPanel>
                        <DataGrid ItemsSource="{Binding OrdersView}" SelectedItem="{Binding SelectedOrder}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pedido" Binding="{Binding Id}" Width="75" />
                                <DataGridTextColumn Header="Data" Binding="{Binding LocalOrderDate, StringFormat=dd/MM/yyyy HH:mm}" Width="140" />
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Usuario.Nome}" Width="*" />
                                <DataGridTextColumn Header="Pagamento" Binding="{Binding PaymentStatusLabel}" Width="120" />
                                <DataGridTextColumn Header="Pedido" Binding="{Binding StatusLabel}" Width="110" />
                                <DataGridTextColumn Header="Metodo" Binding="{Binding PaymentMethod}" Width="110" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Alunos">
                        <DockPanel Margin="12">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Novo cadastro" Click="NewStudent_OnClick" />
                                <Button Content="Editar cadastro" Click="EditStudent_OnClick" IsEnabled="{Binding HasStudent}" />
                                <Button Content="Excluir cadastro" Background="#8C3A36" Click="DeleteStudent_OnClick" IsEnabled="{Binding HasStudent}" />
                            </StackPanel>
                        <DataGrid ItemsSource="{Binding StudentsView}" SelectedItem="{Binding SelectedStudent}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Aluno" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" />
                                <DataGridTextColumn Header="Telefone" Binding="{Binding Phone}" Width="130" />
                                <DataGridTextColumn Header="Curso" Binding="{Binding CourseName}" Width="2*" />
                                <DataGridTextColumn Header="Matricula" Binding="{Binding EnrollmentDate}" Width="110" />
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Background="#99000000" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="260" Padding="24" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="5" />
                    <TextBlock Text="Processando…" HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>