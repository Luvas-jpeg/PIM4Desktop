<Window x:Class="PIM4AdminDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediShop Administração" Language="pt-BR"
        Width="1280" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid x:Name="LoginView">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid MaxWidth="960" Margin="40" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="#153C49" CornerRadius="16,0,0,16" Padding="40">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#27766C" CornerRadius="8" Padding="10,5" Margin="0,0,12,0"><TextBlock Text="+" Foreground="White" FontSize="25" FontWeight="SemiBold" /></Border>
                            <TextBlock Text="MediShop" Foreground="White" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,48,0,48">
                            <TextBlock Text="Mais clareza.&#10;Melhor gestão." Foreground="White" FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Cursos, turmas, pedidos e alunos em um só lugar." Foreground="#C1D9DD" FontSize="16" TextWrapping="Wrap" LineHeight="25" Margin="0,20,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="PAINEL ADMINISTRATIVO" Foreground="#A4CDC5" FontSize="11" FontWeight="SemiBold" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,1,1" CornerRadius="0,16,16,0" Padding="36,40">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bem-vindo de volta" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Entre com sua conta de administrador." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,28" />
                        <Label Target="{Binding ElementName=EmailTextBox}" Content="E-mail" Padding="0" Margin="0,0,0,7" FontWeight="SemiBold" />
                        <TextBox x:Name="EmailTextBox" Margin="0,0,0,18" MinHeight="42" AutomationProperties.Name="E-mail" />
                        <Label Target="{Binding ElementName=PasswordInput}" Content="Senha" Padding="0" Margin="0,0,0,7" FontWeight="SemiBold" />
                        <PasswordBox x:Name="PasswordInput" Margin="0,0,0,24" KeyDown="PasswordInput_OnKeyDown" AutomationProperties.Name="Senha" />
                        <Border Padding="12" Margin="0,0,0,16" Background="#FFF1F0" CornerRadius="6"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" />
                        </Border>
                        <Button Content="Entrar no painel" MinHeight="44" Margin="0" Style="{StaticResource PrimaryButton}" Click="LoginButton_OnClick" />
                        <TextBlock Text="Acesso restrito à administração do instituto." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,22,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="AdminView">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24,18" Background="#153C49">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="MediShop  /  Administração" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AdministratorName}" Foreground="#D3E6E8" VerticalAlignment="Center" Margin="12,0" />
                        <Button Content="Atualizar" Click="RefreshButton_OnClick" />
                        <Button Content="Sair" Click="LogoutButton_OnClick" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Visão geral" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LastUpdated, StringFormat=Atualizado em {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" MaxWidth="560">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="DarkGreen" TextWrapping="Wrap" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300"
                                 HorizontalAlignment="Right" Margin="0,6,0,0" ToolTip="Buscar por nome, curso, e-mail ou pedido"
                                 AutomationProperties.Name="Buscar nas listas" />
                        <TextBlock Text="Buscar por nome, curso, e-mail ou pedido" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                    </StackPanel>
                </DockPanel>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,4,0,22">
                    <Border Style="{StaticResource MetricCard}" Margin="0,0,12,0"><StackPanel>
                        <TextBlock Text="Cursos ativos" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding ActiveCourses}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}" Margin="0,0,12,0"><StackPanel>
                        <TextBlock Text="Pedidos pendentes" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding PendingOrders}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}" Margin="0,0,12,0"><StackPanel>
                        <TextBlock Text="Alunos ativos" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding ActiveStudents}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}" Background="#E8F3EF" BorderBrush="#C7E0D7"><StackPanel>
                        <TextBlock Text="Receita confirmada" Foreground="#285E50" />
                        <TextBlock Text="{Binding PaidRevenue, StringFormat=C}" Foreground="#16634F" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0" />
                    </StackPanel></Border>
                </UniformGrid>

                <TabControl Grid.Row="2">
                    <TabItem Header="Cursos">
                        <DockPanel Margin="12">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Style="{StaticResource PrimaryButton}" Content="Novo curso" Click="NewCourse_OnClick" />
                                <Button Content="Editar curso" Click="EditCourse_OnClick" IsEnabled="{Binding HasCourse}" />
                                <Button Content="Arquivar / restaurar" Click="ArchiveCourse_OnClick" IsEnabled="{Binding HasCourse}" />
                            </StackPanel>
                        <DataGrid ItemsSource="{Binding CoursesView}" SelectedItem="{Binding SelectedCourse}" SelectionMode="Single" SelectionChanged="CourseSelection_OnChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                                <DataGridTextColumn Header="Curso" Binding="{Binding Nome}" Width="2*" />
                                <DataGridTextColumn Header="Modalidade" Binding="{Binding DeliveryMode}" Width="110" />
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="*" />
                                <DataGridTextColumn Header="Carga" Binding="{Binding WorkloadHours, StringFormat={}{0}h}" Width="80" />
                                <DataGridTextColumn Header="Preço" Binding="{Binding Preco, StringFormat=C}" Width="110" />
                                <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding IsActive}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Turmas">
                        <DockPanel Margin="12">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Selecione o curso para administrar suas turmas" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}"
                                          SelectionChanged="CourseSelection_OnChanged" DisplayMemberPath="Nome" MinHeight="28" Padding="4" AutomationProperties.Name="Curso das turmas" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Nova turma" Click="NewClass_OnClick" IsEnabled="{Binding HasCourse}" />
                                    <Button Content="Editar turma" Click="EditClass_OnClick" IsEnabled="{Binding HasClass}" />
                                    <Button Content="Alunos da turma" Click="ClassStudents_OnClick" IsEnabled="{Binding HasClass}" />
                                </StackPanel>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Turma" Binding="{Binding Id}" Width="70" />
                                    <DataGridTextColumn Header="Início (local)" Binding="{Binding LocalStartDate, StringFormat=dd/MM/yyyy HH:mm}" Width="160" />
                                    <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="*" />
                                    <DataGridTextColumn Header="Instrutor" Binding="{Binding Instructor}" Width="*" />
                                    <DataGridTextColumn Header="Capacidade" Binding="{Binding Capacity}" Width="100" />
                                    <DataGridTextColumn Header="Vagas" Binding="{Binding AvailableSeats}" Width="70" />
                                    <DataGridTextColumn Header="Situação" Binding="{Binding StatusLabel}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Pedidos">
                        <DockPanel Margin="12">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Detalhes / alterar situação" Click="EditOrder_OnClick" IsEnabled="{Binding HasOrder}" />
                            </StackPanel>
                        <DataGrid ItemsSource="{Binding OrdersView}" SelectedItem="{Binding SelectedOrder}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pedido" Binding="{Binding Id}" Width="75" />
                                <DataGridTextColumn Header="Data" Binding="{Binding LocalOrderDate, StringFormat=dd/MM/yyyy HH:mm}" Width="140" />
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Usuario.Nome}" Width="*" />
                                <DataGridTextColumn Header="Pagamento" Binding="{Binding PaymentStatusLabel}" Width="120" />
                                <DataGridTextColumn Header="Pedido" Binding="{Binding StatusLabel}" Width="110" />
                                <DataGridTextColumn Header="Método" Binding="{Binding PaymentMethod}" Width="110" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Alunos">
                        <DockPanel Margin="12">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Style="{StaticResource PrimaryButton}" Content="Novo cadastro" Click="NewStudent_OnClick" />
                                <Button Content="Editar cadastro" Click="EditStudent_OnClick" IsEnabled="{Binding HasStudent}" />
                                <Button Content="Excluir cadastro" Click="DeleteStudent_OnClick" IsEnabled="{Binding HasStudent}" />
                            </StackPanel>
                        <DataGrid ItemsSource="{Binding StudentsView}" SelectedItem="{Binding SelectedStudent}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Aluno" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" />
                                <DataGridTextColumn Header="Telefone" Binding="{Binding Phone}" Width="130" />
                                <DataGridTextColumn Header="Curso" Binding="{Binding CourseName}" Width="2*" />
                                <DataGridTextColumn Header="Matrícula" Binding="{Binding EnrollmentDate}" Width="110" />
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Background="#99000000" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="280" CornerRadius="10" Padding="28" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="5" />
                    <TextBlock Text="Processando…" HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>