<Window x:Class="PIM4AdminDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediShop Administração" Language="pt-BR"
        Width="1280" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="28" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="LoginView">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Width="350" Padding="16" VerticalAlignment="Center" BorderBrush="Gray" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="MediShop" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Administração" Margin="0,4,0,8" FontSize="14" />
                    <TextBlock Text="Acesso restrito aos administradores do instituto." Foreground="DimGray" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <TextBlock Text="E-mail" Margin="0,0,0,4" />
                    <TextBox x:Name="EmailTextBox" Margin="0,0,0,12" />
                    <TextBlock Text="Senha" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordInput" Margin="0,0,0,20" KeyDown="PasswordInput_OnKeyDown" />

                    <Border Padding="10" Margin="0,0,0,16" Background="#FFF1F0"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" />
                    </Border>

                    <Button Content="Entrar no painel" Height="30" Click="LoginButton_OnClick" />
                    <TextBlock Text="{Binding ApiAddress, StringFormat=API: {0}}" Foreground="DimGray"
                               FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="AdminView">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12" BorderBrush="Gray" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="MediShop — Administração" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AdministratorName}" VerticalAlignment="Center" Margin="12,0" />
                        <Button Content="Atualizar" Click="RefreshButton_OnClick" />
                        <Button Content="Sair" Click="LogoutButton_OnClick" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Resumo" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="{Binding LastUpdated, StringFormat=Atualizado em {0}}" Foreground="DimGray" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" MaxWidth="560">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="DarkGreen" TextWrapping="Wrap" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300"
                                 HorizontalAlignment="Right" Margin="0,6,0,0" ToolTip="Buscar por nome, curso, e-mail ou pedido"
                                 AutomationProperties.Name="Buscar nas listas" />
                        <TextBlock Text="Buscar por nome, curso, e-mail ou pedido" Foreground="DimGray" FontSize="11" HorizontalAlignment="Right" />
                    </StackPanel>
                </DockPanel>

                <GroupBox Grid.Row="1" Header="Indicadores" Margin="0,0,0,12" Padding="8">
                    <WrapPanel>
                        <TextBlock Text="{Binding ActiveCourses, StringFormat=Cursos ativos: {0}}" Margin="0,0,24,0" />
                        <TextBlock Text="{Binding PendingOrders, StringFormat=Pedidos pendentes: {0}}" Margin="0,0,24,0" />
                        <TextBlock Text="{Binding ActiveStudents, StringFormat=Alunos ativos: {0}}" Margin="0,0,24,0" />
                        <TextBlock Text="{Binding PaidRevenue, StringFormat=Receita confirmada: {0:C}}" />
                    </WrapPanel>
                </GroupBox>

                <TabControl Grid.Row="2">
                    <TabItem Header="Cursos">
                        <DockPanel Margin="12">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Novo curso" Click="NewCourse_OnClick" />
                                <Button Content="Editar curso" Click="EditCourse_OnClick" IsEnabled="{Binding HasCourse}" />
                                <Button Content="Arquivar / restaurar" Click="ArchiveCourse_OnClick" IsEnabled="{Binding HasCourse}" />
                            </StackPanel>
                        <DataGrid ItemsSource="{Binding CoursesView}" SelectedItem="{Binding SelectedCourse}" SelectionMode="Single" SelectionChanged="CourseSelection_OnChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                                <DataGridTextColumn Header="Curso" Binding="{Binding Nome}" Width="2*" />
                                <DataGridTextColumn Header="Modalidade" Binding="{Binding DeliveryMode}" Width="110" />
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="*" />
                                <DataGridTextColumn Header="Carga" Binding="{Binding WorkloadHours, StringFormat={}{0}h}" Width="80" />
                                <DataGridTextColumn Header="Preco" Binding="{Binding Preco, StringFormat=C}" Width="110" />
                                <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding IsActive}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Turmas">
                        <DockPanel Margin="12">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Selecione o curso para administrar suas turmas" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}"
                                          SelectionChanged="CourseSelection_OnChanged" DisplayMemberPath="Nome" MinHeight="28" Padding="4" AutomationProperties.Name="Curso das turmas" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Nova turma" Click="NewClass_OnClick" IsEnabled="{Binding HasCourse}" />
                                    <Button Content="Editar turma" Click="EditClass_OnClick" IsEnabled="{Binding HasClass}" />
                                    <Button Content="Alunos da turma" Click="ClassStudents_OnClick" IsEnabled="{Binding HasClass}" />
                                </StackPanel>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Turma" Binding="{Binding Id}" Width="70" />
                                    <DataGridTextColumn Header="Início (local)" Binding="{Binding LocalStartDate, StringFormat=dd/MM/yyyy HH:mm}" Width="160" />
                                    <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="*" />
                                    <DataGridTextColumn Header="Instrutor" Binding="{Binding Instructor}" Width="*" />
                                    <DataGridTextColumn Header="Capacidade" Binding="{Binding Capacity}" Width="100" />
                                    <DataGridTextColumn Header="Vagas" Binding="{Binding AvailableSeats}" Width="70" />
                                    <DataGridTextColumn Header="Situação" Binding="{Binding StatusLabel}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Pedidos">
                        <DockPanel Margin="12">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Detalhes / alterar situação" Click="EditOrder_OnClick" IsEnabled="{Binding HasOrder}" />
                            </StackPanel>
                        <DataGrid ItemsSource="{Binding OrdersView}" SelectedItem="{Binding SelectedOrder}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pedido" Binding="{Binding Id}" Width="75" />
                                <DataGridTextColumn Header="Data" Binding="{Binding LocalOrderDate, StringFormat=dd/MM/yyyy HH:mm}" Width="140" />
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Usuario.Nome}" Width="*" />
                                <DataGridTextColumn Header="Pagamento" Binding="{Binding PaymentStatusLabel}" Width="120" />
                                <DataGridTextColumn Header="Pedido" Binding="{Binding StatusLabel}" Width="110" />
                                <DataGridTextColumn Header="Metodo" Binding="{Binding PaymentMethod}" Width="110" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Alunos">
                        <DockPanel Margin="12">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Novo cadastro" Click="NewStudent_OnClick" />
                                <Button Content="Editar cadastro" Click="EditStudent_OnClick" IsEnabled="{Binding HasStudent}" />
                                <Button Content="Excluir cadastro" Click="DeleteStudent_OnClick" IsEnabled="{Binding HasStudent}" />
                            </StackPanel>
                        <DataGrid ItemsSource="{Binding StudentsView}" SelectedItem="{Binding SelectedStudent}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Aluno" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" />
                                <DataGridTextColumn Header="Telefone" Binding="{Binding Phone}" Width="130" />
                                <DataGridTextColumn Header="Curso" Binding="{Binding CourseName}" Width="2*" />
                                <DataGridTextColumn Header="Matricula" Binding="{Binding EnrollmentDate}" Width="110" />
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Background="#99000000" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="260" Padding="24" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="5" />
                    <TextBlock Text="Processando…" HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>